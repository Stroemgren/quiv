<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content="Quiv gives players and AI assistants exact answers about a game's rules, mechanics and content, taken straight from the game's own files."
    />
    <meta name="theme-color" content="#15133a" />
    <.live_title default="Quiv" suffix=" · Quiv">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" href={~p"/images/favicon.svg"} type="image/svg+xml" />
    <link rel="icon" href={~p"/favicon.ico"} sizes="32x32" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="min-h-full bg-canvas text-ink antialiased">
    {@inner_content}
  </body>
</html>
